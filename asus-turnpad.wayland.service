[Unit]
Description=Turnpad driver (ASUS DialPad)
# Stop with the graphical session and start again with the next one, so a
# logout does not leave the service restarting without a display.
PartOf=graphical-session.target
After=graphical-session.target
StartLimitBurst=20
StartLimitIntervalSec=300

[Service]
Type=simple
# Commands of dial actions run as the user and can never gain privileges
# (sudo, pkexec and other setuid helpers fail), even with passwordless sudo.
NoNewPrivileges=yes
ExecStart=$INSTALL_DIR_PATH/.env/bin/python3 $INSTALL_DIR_PATH/dialpad.py $LAYOUT_NAME $CONFIG_FILE_DIR_PATH
TimeoutSec=5
Restart=on-failure
RestartSec=1
# The script logs to the journal directly
StandardOutput=null
StandardError=null
Environment="DISPLAY=$DISPLAY"
Environment="WAYLAND_DISPLAY=$WAYLAND_DISPLAY"
Environment="DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS"
Environment="XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
Environment="XDG_SESSION_TYPE=$XDG_SESSION_TYPE"
Environment="PATH=/usr/sbin:/usr/bin:/bin"
$LOG_ENV_LINE

[Install]
# default.target covers sessions without graphical-session.target
# (for example sway or Hyprland started without a session manager).
WantedBy=default.target graphical-session.target
