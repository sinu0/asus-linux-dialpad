[Unit]
Description=Turnpad on-screen dial (layer-shell)
# Wayland desktops other than GNOME: KDE Plasma 6, Hyprland, sway, niri,
# COSMIC (install_layer_shell_overlay.sh). The session hands WAYLAND_DISPLAY
# to the user's service manager when it starts graphical-session.target.
# Stop with the graphical session and start again with the next one.
PartOf=graphical-session.target
After=graphical-session.target plasma-workspace.target
StartLimitBurst=20
StartLimitIntervalSec=300

[Service]
Type=simple
# Commands of dial actions run as the user and can never gain privileges
# (sudo, pkexec and other setuid helpers fail), even with passwordless sudo.
NoNewPrivileges=yes
ExecStart=$PYTHON $INSTALL_DIR_PATH/overlay/layer_shell.py
TimeoutSec=5
Restart=on-failure
RestartSec=1
# Exit status 3: no layer-shell here (GNOME has the extension, X11 the
# legacy window), so starting again would not help.
RestartPreventExitStatus=3

[Install]
WantedBy=graphical-session.target
