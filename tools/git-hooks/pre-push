#!/bin/sh
# Stops a push while the README pictures in preview/ are outdated.
#
# Enable once per clone:   git config core.hooksPath tools/git-hooks
# Skip for one push:       SKIP_PREVIEWS=1 git push   (or git push --no-verify)
#
# Runs only when the pushed commits touch what the pictures show; the
# settings app renders in a headless mutter, so no window shows up.

[ -n "$SKIP_PREVIEWS" ] && exit 0

ROOT=$(git rev-parse --show-toplevel)
SHOWN='^(gnome/extension/|config_app/|overlay/|config/|tools/(render_overlay_preview\.js|screenshot_settings\.py))'
ZERO=0000000000000000000000000000000000000000

relevant=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue
    if [ "$remote_sha" = "$ZERO" ]; then
        relevant=1
    elif git diff --name-only "$remote_sha" "$local_sha" | grep -Eq "$SHOWN"; then
        relevant=1
    fi
done
[ "$relevant" = 1 ] || exit 0

if ! command -v gjs >/dev/null 2>&1 || ! python3 -c "import PIL" 2>/dev/null; then
    echo "pre-push: gjs or Pillow missing, README pictures not checked" >&2
    exit 0
fi

echo "pre-push: checking README pictures..." >&2
if ! python3 "$ROOT/tools/update_previews.py" --check >&2; then
    echo "pre-push: commit the updated pictures first: python3 tools/update_previews.py" >&2
    exit 1
fi
